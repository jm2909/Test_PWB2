# Root-level reference for local and container configuration.
# Local runs read backend/.env (created from backend/dev.env by start.sh); see README.md.

# --- Backend (backend/.env) ---
# development | local | production. Production-like values enforce a real JWT secret.
ENVIRONMENT=development
DEBUG=true
# Default sqlite:///./app.db. PostgreSQL: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app.db
# REQUIRED in production, >= 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-for-production
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=480
SESSION_INACTIVITY_MINUTES=30
# Comma-separated explicit origins; start.sh rewrites this to the chosen frontend port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_RIGHTS_FULFILLMENT_DAYS=30
FRESHNESS_STALE_AFTER_HOURS=24
WEARABLE_PROVIDERS=fitband,pulsewear
LOGIN_RATE_LIMIT=10/minute
RATE_LIMIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
# Run the idempotent demo seed when the API boots
SEED_ON_STARTUP=true

# --- Frontend (frontend/.env, optional) ---
# Leave VITE_API_URL unset; the browser calls relative /api.
# BACKEND_PORT is set by start.sh for the Vite dev proxy (default 9000).
BACKEND_PORT=9000
