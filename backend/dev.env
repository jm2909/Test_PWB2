# Local development configuration (committed). start.sh copies this to .env when .env is absent.
# Never put production credentials here.
DATABASE_URL=sqlite:///./app.db
JWT_SECRET_KEY=dev-only-local-secret-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=30
SESSION_INACTIVITY_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEBUG=true
SEED_ON_START=true
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
ADAPTER_MODE=simulated
