# Local development values (committed). start.sh copies this to backend/.env if absent.
# Never put production credentials here.
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./app.db
JWT_SECRET_KEY=dev-only-secret-not-for-production-0123456789abcdef
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=480
SESSION_INACTIVITY_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_RIGHTS_FULFILLMENT_DAYS=30
FRESHNESS_STALE_AFTER_HOURS=24
WEARABLE_PROVIDERS=fitband,pulsewear
LOGIN_RATE_LIMIT=10/minute
RATE_LIMIT_ENABLED=true
AUDIT_RETENTION_DAYS=365
SEED_ON_STARTUP=true
