# Copy to .env and adjust. All values are read by app/config.py (Settings).

# Required (default sqlite:///./app.db): SQLAlchemy URL. SQLite locally; PostgreSQL elsewhere: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app.db
# Required (no default, min 16 chars): signing key for JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-48-byte-secret
# Optional (default 30): access token lifetime in minutes
JWT_EXPIRE_MINUTES=30
# Optional (default 30): idle minutes before a session expires
SESSION_INACTIVITY_MINUTES=30
# Optional: comma-separated explicit allowed origins (no wildcard)
CORS_ORIGINS=http://localhost:5173
# Optional (default false): exposes /docs and /openapi.json when true
DEBUG=false
# Optional (default false): run registered seeds at startup (dev only)
SEED_ON_START=false
# Optional (default true): enable auth rate limiting
RATE_LIMIT_ENABLED=true
# Optional (default 10/minute): login attempts allowed per client
LOGIN_RATE_LIMIT=10/minute
# Optional (default simulated): deterministic device/provider adapters
ADAPTER_MODE=simulated
# Optional: AI inference provider; empty uses deterministic local inference
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
# Optional: OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
