# Backend settings. Copy to .env (start.sh copies dev.env automatically for local use).
# "Required" means required when ENVIRONMENT is not development/local.

# development | local | (anything else is treated as production-like)   default: development
ENVIRONMENT=development
# Enables /docs and /openapi.json                                         default: false
DEBUG=false
# SQLAlchemy URL. SQLite locally, PostgreSQL (postgresql+psycopg://user:pass@host:5432/db) elsewhere.
DATABASE_URL=sqlite:///./app.db
# REQUIRED in production-like environments, >= 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Absolute session lifetime / inactivity window (minutes)                  defaults: 480 / 30
SESSION_TTL_MINUTES=480
SESSION_INACTIVITY_MINUTES=30
# Comma-separated explicit origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173
# Data-rights fulfilment window (days), stale-data threshold (hours)       defaults: 30 / 24
DATA_RIGHTS_FULFILLMENT_DAYS=30
FRESHNESS_STALE_AFTER_HOURS=24
# Comma-separated wearable providers enabled in this deployment
WEARABLE_PROVIDERS=fitband,pulsewear
# Per-source-IP login limit "<count>/<second|minute|hour>"; set RATE_LIMIT_ENABLED=false only in tests
LOGIN_RATE_LIMIT=10/minute
RATE_LIMIT_ENABLED=true
# Honour X-Forwarded-For only behind a trusted proxy
TRUST_FORWARDED_FOR=false
# Audit retention metadata (days)
AUDIT_RETENTION_DAYS=365
# Run the idempotent demo seed at application startup
SEED_ON_STARTUP=false
