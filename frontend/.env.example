# Leave VITE_API_URL unset: the browser calls the relative /api (Vite proxy in dev, nginx in the image).
# Set it only when the API lives on another public origin, to a URL that includes /api.
# VITE_API_URL=

# Port the Vite dev proxy forwards /api to (read by vite.config.ts; start.sh sets it).
BACKEND_PORT=9000
